\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces UDP standalone methods vs supervised baselines across four ODDS benchmarks (5-fold CV). UDP-QDA-Opt (dark blue) matches or approaches tree baselines on Mammography and Pendigits while using only closed-form QDA with a single hyperparameter. XGBoost and LightGBM (warm colours) run independently on raw features---they are \emph  {not} mixed into the UDP pipeline.}}{12}{figure.caption.20}\protected@file@percent }
\newlabel{fig:udl_vs_baselines}{{9}{12}{UDP standalone methods vs supervised baselines across four ODDS benchmarks (5-fold CV). UDP-QDA-Opt (dark blue) matches or approaches tree baselines on Mammography and Pendigits while using only closed-form QDA with a single hyperparameter. XGBoost and LightGBM (warm colours) run independently on raw features---they are \emph {not} mixed into the UDP pipeline}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Mean AUC-ROC summary across four ODDS datasets. UDP-QDA-Opt achieves mAUC~$0.931$, the strongest UDP variant, vs LightGBM's~$0.968$. The $3.7$~pp gap is attributable to trees' capacity for non-linear feature interaction on raw inputs---a capability UDP trades for interpretable per-operator attribution and theoretical guarantees.}}{12}{figure.caption.21}\protected@file@percent }
\newlabel{fig:udl_mauc}{{10}{12}{Mean AUC-ROC summary across four ODDS datasets. UDP-QDA-Opt achieves mAUC~$0.931$, the strongest UDP variant, vs LightGBM's~$0.968$. The $3.7$~pp gap is attributable to trees' capacity for non-linear feature interaction on raw inputs---a capability UDP trades for interpretable per-operator attribution and theoretical guarantees}{figure.caption.21}{}}
