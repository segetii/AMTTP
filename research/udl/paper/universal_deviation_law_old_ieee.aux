\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Solo operator mean coverage across five datasets. Operators are ranked by mCov and colour-coded by mathematical family. Phase-curve (86\%) and topological persistence (78\%) lead; statistical and compression operators fall below the 70\% utility threshold. No single operator exceeds 86\%, confirming that multi-operator fusion is necessary.}}{9}{figure.caption.10}\protected@file@percent }
\newlabel{fig:solo_bars}{{3}{9}{Solo operator mean coverage across five datasets. Operators are ranked by mCov and colour-coded by mathematical family. Phase-curve (86\%) and topological persistence (78\%) lead; statistical and compression operators fall below the 70\% utility threshold. No single operator exceeds 86\%, confirming that multi-operator fusion is necessary}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Spearman correlation between 14 spectrum operators (hierarchically clustered). Dashed red box marks the only redundant pair: Wavelet~$\leftrightarrow $~Phase ($\rho {=}0.92$). The topological operator (Topo) is the most independent, with maximum $\rho {=}0.39$. Operator families are colour-coded on the axes.}}{9}{figure.caption.11}\protected@file@percent }
\newlabel{fig:corr_heatmap}{{4}{9}{Spearman correlation between 14 spectrum operators (hierarchically clustered). Dashed red box marks the only redundant pair: Wavelet~$\leftrightarrow $~Phase ($\rho {=}0.92$). The topological operator (Topo) is the most independent, with maximum $\rho {=}0.39$. Operator families are colour-coded on the axes}{figure.caption.11}{}}
