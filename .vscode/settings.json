{
    "inlineChat.notebookAgent": true,
    // Ensure VS Code shell integration is enabled to improve command detection
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.enablePersistentSessions": false,
    "terminal.integrated.scrollback": 2000,
    // Default to Windows PowerShell as requested environment
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    // Define the PowerShell profile explicitly
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell"
        }
    },
    "terminal.integrated.accessibleViewFocusOnCommandExecution": true,
    "git.autorefresh": false,
    "git.untrackedChanges": "hidden",
    "git.openRepositoryInParentFolders": "never",
    "git.repositoryScanIgnoredFolders": [
        "data",
        "processed",
        "model_artifacts",
        "results",
        "node_modules",
        ".venv",
        "frontend/amttp_app/build",
        "research/quantum/results",
        "research/supply-chain/figures"
    ],
    "explorer.autoReveal": false,
    "breadcrumbs.enabled": false,
    "workbench.editor.enablePreview": false,
    "typescript.tsserver.maxTsServerMemory": 512,
    "typescript.disableAutomaticTypeAcquisition": true,
    "typescript.tsserver.watchOptions": {
        "excludeDirectories": ["**/node_modules", "**/.next", "**/build", "**/dist", "**/forge-out", "**/coverage"]
    },
    "typescript.suggest.enabled": false,
    "typescript.validate.enable": false,
    "chat.tools.terminal.autoApprove": {
        "cls": true,
        "Out-File": true,
        "Tee-Object": true,
        "forge": true,
        "echidna": true,
        "Get-Item": true,
        "docker compose": true,
        "docker exec": true,
        "docker rm": true,
        "docker restart": true,
        "git push": true,
        "&": true
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/.mypy_cache": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "data": true,
        "processed": true,
        "model_artifacts": true,
        "results": true,
        "research/quantum/results": true,
        "research/supply-chain/figures": true,
        "**/*.pyc": true,
        "**/*.pyo": true,
        "**/*.aux": true,
        "**/*.out": true,
        "**/*.log": true,
        "_archive": true,
        "_student_artifacts": true,
        "forge-out": true,
        "forge-cache": true,
        "crytic-export": true,
        "solidity_coverage": true,
        ".openzeppelin": true,
        "github-repos": true,
        "cache": true,
        "hardhat": true,
        "plots": true,
        "screenshots": true,
        "reports": true,
        "documentation": true,
        "docs": true,
        "notebooks": true,
        "ml": true,
        "lib": true,
        "coverage": true,
        "audit": true,
        "deployments": true,
        "spec": true,
        "tools": true,
        "automation": true,
        "docker": true
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/__pycache__/**": true,
        "**/.mypy_cache/**": true,
        "**/.pytest_cache/**": true,
        "**/.ruff_cache/**": true,
        "**/.tox/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/*.pyc": true,
        "**/*.pyo": true,
        "**/build/**": true,
        "**/dist/**": true,
        "**/.next/**": true,
        "**/coverage/**": true,
        "**/cache/**": true,
        "**/forge-cache/**": true,
        "**/forge-out/**": true,
        "**/foundry-bin/**": true,
        "**/_archive/**": true,
        "frontend/amttp_app/build/**": true,
        "data/**": true,
        "processed/**": true,
        "model_artifacts/**": true,
        "results/**": true,
        "research/quantum/results/**": true,
        "research/supply-chain/figures/**": true,
        "**/*.aux": true,
        "**/*.out": true,
        "**/*.log": true,
        "**/*.pdf": true,
        "**/*.png": true,
        "**/*.jpg": true,
        "**/*.jpeg": true,
        "_student_artifacts/**": true,
        "crytic-export/**": true,
        "solidity_coverage/**": true,
        ".openzeppelin/**": true,
        "github-repos/**": true,
        "hardhat/**": true,
        "plots/**": true,
        "screenshots/**": true,
        "lib/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/*.pyo": true,
        "**/.mypy_cache": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/.tox": true,
        "**/.venv": true,
        "**/venv": true,
        "**/build": true,
        "**/dist": true,
        "**/.next": true,
        "**/coverage": true,
        "**/cache": true,
        "**/forge-cache": true,
        "**/forge-out": true,
        "**/foundry-bin": true,
        "**/_archive": true,
        "frontend/amttp_app/build": true,
        "data": true,
        "processed": true,
        "model_artifacts": true,
        "results": true,
        "research/quantum/results": true,
        "research/supply-chain/figures": true,
        "**/*.aux": true,
        "**/*.out": true,
        "**/*.log": true
    },
    "extensions.autoUpdate": false,
    "extensions.autoCheckUpdates": false,
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.value": 5,
    "editor.minimap.enabled": false,
    "editor.bracketPairColorization.enabled": false,
    "editor.occurrencesHighlight": "off",
    "editor.codeLens": false,
    "editor.hover.delay": 1000,
    "editor.quickSuggestions": { "other": false, "comments": false, "strings": false },
    "editor.parameterHints.enabled": false,
    "editor.wordBasedSuggestions": "off",
    "editor.suggestOnTriggerCharacters": false,
    "files.participants.timeout": 5000,
    "git.decorations.enabled": false,
    "git.enabled": false,
    "scm.diffDecorations": "none",
    "telemetry.telemetryLevel": "off",
    "update.mode": "none",
    "window.restoreWindows": "none",
    "python.analysis.diagnosticMode": "openFilesOnly",
    "python.analysis.indexing": false,
    "python.analysis.autoSearchPaths": false,
    "python.analysis.useLibraryCodeForTypes": false,
    "python.analysis.exclude": [
        "**/__pycache__/**",
        "**/.mypy_cache/**",
        "**/.pytest_cache/**",
        "**/.ruff_cache/**",
        "**/.tox/**",
        "**/.venv/**",
        "**/venv/**",
        "**/node_modules/**",
        "**/build/**",
        "**/dist/**",
        "**/.next/**",
        "**/coverage/**",
        "**/cache/**",
        "**/forge-cache/**",
        "**/forge-out/**",
        "**/foundry-bin/**",
        "**/_archive/**",
        "frontend/amttp_app/build/**",
        "data/**",
        "processed/**",
        "model_artifacts/**",
        "results/**",
        "research/quantum/results/**",
        "research/supply-chain/figures/**"
    ],
    "remote.autoForwardPorts": false,
    "jupyter.disableJupyterAutoStart": true
}